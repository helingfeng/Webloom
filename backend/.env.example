# 复制为 .env 并按需修改；所有项均有内置默认值
# 平台主库（MySQL，需先执行 backend/mysql_ddl.sql 顶部的建库语句或手工建库）
DATABASE_URL=mysql+aiomysql://root:helingfeng@127.0.0.1:3306/fishcode?charset=utf8mb4
# HEADLESS=true
# SCRIPT_EXECUTION_TIMEOUT=120

# ---- 执行队列（Redis + arq worker）----
# 本地需先启动 Redis：redis-server（或 brew services start redis）
# REDIS_URL=redis://127.0.0.1:6379/0
# worker 最大并发执行数（每个执行 = 1 个子进程 + 1 个 Chromium）
# MAX_CONCURRENT_EXECUTIONS=5

# ---- 数据采集 ----
# 数据视图预取结果 TTL 缓存秒数（仅 worker 侧；0 关闭）
# CACHE_TTL_SECONDS=30
# 数据源外部库连接池
# DATASOURCE_POOL_SIZE=5
# DATASOURCE_MAX_OVERFLOW=10
# 平台主库连接池
# DATABASE_POOL_SIZE=20
# DATABASE_MAX_OVERFLOW=40

# ---- 开放平台 ----
# 开放接口签名时间窗（秒），X-Timestamp 与服务器偏差超限拒绝
# OPEN_API_SIGN_TTL_SECONDS=300
# 代理接口转发目标（平台自身 API 地址）
# OPEN_API_INTERNAL_BASE_URL=http://127.0.0.1:8000
