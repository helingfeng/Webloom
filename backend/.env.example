# 复制为 .env 并按需修改；所有项均有内置默认值
# 平台主库（MySQL，需先执行 backend/mysql_ddl.sql 顶部的建库语句或手工建库）
DATABASE_URL=mysql+aiomysql://root:helingfeng@127.0.0.1:3306/fishcode?charset=utf8mb4
# HEADLESS=true
# SCRIPT_EXECUTION_TIMEOUT=120

# ---- 执行队列（Redis + arq worker）----
# 本地需先启动 Redis：redis-server（或 brew services start redis）
# REDIS_URL=redis://127.0.0.1:6379/0
# worker 最大并发执行数（每个执行 = 1 个子进程 + 1 个 Chromium）
# MAX_CONCURRENT_EXECUTIONS=5

# ---- 数据采集 ----
# 数据视图预取结果 TTL 缓存秒数（仅 worker 侧；0 关闭）
# CACHE_TTL_SECONDS=30
# 数据源外部库连接池
# DATASOURCE_POOL_SIZE=5
# DATASOURCE_MAX_OVERFLOW=10
# 平台主库连接池
# DATABASE_POOL_SIZE=20
# DATABASE_MAX_OVERFLOW=40

# ---- 开放平台 ----
# 开放接口签名时间窗（秒），X-Timestamp 与服务器偏差超限拒绝
# OPEN_API_SIGN_TTL_SECONDS=300

# ---- 浏览器引擎 ----
# playwright 保持普通 Chromium；cloakbrowser 使用官方 CloakBrowser（需要许可证）
# BROWSER_ENGINE=playwright
# CloakBrowser 密钥仅保存在未跟踪的 .env，不要提交到仓库
# CLOAKBROWSER_LICENSE_KEY=cb_your_key
# 以下选项仅在 BROWSER_ENGINE=cloakbrowser 时生效
# CLOAKBROWSER_HUMANIZE=true
# CLOAKBROWSER_PROXY_URL=http://user:password@proxy.example:8080
# CLOAKBROWSER_LOCALE=zh-CN
# CLOAKBROWSER_TIMEZONE=Asia/Shanghai

# ---- 低负载采集（两种浏览器通用，修改后重启 API 与 worker）----
# 同一 hostname 的主动导航/API/翻页操作间隔，跨 MCP/worker/子进程共享
# COLLECTION_MIN_INTERVAL_SECONDS=2
# 401/403/429/503 或验证页后的最短冷却；尊重更长的 Retry-After
# COLLECTION_COOLDOWN_SECONDS=300
# 每次执行的主动操作预算（不包含浏览器加载的静态资源）
# COLLECTION_MAX_REQUESTS=50
# 节流排队的最长等待，超出后失败，避免占满执行超时
# COLLECTION_MAX_WAIT_SECONDS=30
